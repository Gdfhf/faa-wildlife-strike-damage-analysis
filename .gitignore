# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/


# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# Optional notebook temporary files
*.nbconvert.ipynb


# =========================
# Data
# =========================

data/raw/*
data/processed/*

!data/raw/.gitkeep
!data/processed/.gitkeep

# Large serialized/model data files
*.parquet
*.feather
*.pkl
*.pickle
*.joblib


# =========================
# Machine-learning outputs
# =========================

models/
artifacts/

# Logs and temporary outputs
logs/
*.log


# =========================
# Streamlit
# =========================

# Local Streamlit secrets
.streamlit/secrets.toml

# Keep shareable Streamlit configuration if created
# .streamlit/config.toml is intentionally NOT ignored


# =========================
# Godot
# =========================

# Godot-generated cache/import data
.godot/

# Godot 3.x generated import files
.import/

# Mono / C# generated files, if applicable
.mono/

# Exported builds
exports/
builds/


# =========================
# IDE / Editor
# =========================

.vscode/
.idea/

# Vim swap files
*.swp
*.swo


# =========================
# Operating system files
# =========================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store


# =========================
# Temporary files
# =========================

*.tmp
*.temp
~$*