# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/


# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# Optional notebook temporary files
*.nbconvert.ipynb


# =========================
# Data
# =========================

data/raw/*
data/processed/*

!data/raw/.gitkeep
!data/processed/.gitkeep

# Large serialized/model data files
*.parquet
*.feather
*.pkl
*.pickle
*.joblib

# --------------------------------------------------
# Dashboard runtime artifacts
# --------------------------------------------------
#
# Most processed data remains excluded from Git. The lightweight
# dashboard artifacts below are explicit exceptions because teammates
# need them to run Streamlit without the ~300 MB analytical CSV.
#
# The parent dashboard directory is re-included in case the artifact
# builder stores the runtime files under data/processed/dashboard/.

!data/processed/dashboard/
data/processed/dashboard/*

# Allow the three dashboard Parquet artifacts
!data/processed/dashboard/historical_explorer.parquet
!data/processed/dashboard/simulation_donor_pool.parquet
!data/processed/dashboard/scenario_support.parquet

# Also allow these uniquely named runtime artifacts if paths.py places
# them in another non-ignored dashboard data directory.
!**/historical_explorer.parquet
!**/simulation_donor_pool.parquet
!**/scenario_support.parquet

# The lightweight overview JSON may live beside the Parquet artifacts.
!data/processed/dashboard/overview_summary.json


# --------------------------------------------------
# Generated model artifacts
# --------------------------------------------------

# Keep the model directory and documentation visible in GitHub.
!models/
!models/README.md
!models/candidates/
!models/final/

# --------------------------------------------------
# Candidate models
# --------------------------------------------------
#
# Candidate binaries are generated intermediate artifacts and may be large.
# Keep their notebook-specific directory structure visible, but do not
# commit the fitted .joblib files.

models/candidates/**/*.joblib

# Preserve notebook-specific candidate directories.
!models/candidates/**/.gitkeep


# --------------------------------------------------
# Final models
# --------------------------------------------------
#
# Final model artifacts are also generated binaries. Ignore them by default,
# then explicitly allow the canonical binary-damage model below.

models/final/**/*.joblib

# Preserve notebook-specific final-model directories.
!models/final/**/.gitkeep


# --------------------------------------------------
# Canonical final binary-damage model
# --------------------------------------------------
#
# Produced by Notebook 06 and consumed by downstream notebooks.

!models/final/06_calibration_validation/final_calibrated_pipeline.joblib

# Produced by Notebook 07
!models/final/07_severity_modelling/final_known_severity_probability_system.joblib

# Produced by Notebook 08
!models/final/08_component_modelling/engine_damage_component_probability_system.joblib
!models/final/08_component_modelling/forward_cockpit_damage_component_probability_system.joblib
!models/final/08_component_modelling/landing_gear_damage_component_probability_system.joblib
!models/final/08_component_modelling/propeller_damage_component_probability_system.joblib
!models/final/08_component_modelling/wing_rotor_damage_component_probability_system.joblib

# Logs and temporary outputs
logs/
*.log


# =========================
# Streamlit
# =========================

# Local Streamlit secrets
.streamlit/secrets.toml

# Keep shareable Streamlit configuration if created
# .streamlit/config.toml is intentionally NOT ignored


# =========================
# Godot
# =========================

# Godot-generated cache/import data
.godot/

# Godot 3.x generated import files
.import/

# Mono / C# generated files, if applicable
.mono/

# Exported builds
exports/

# Ignore compiled Godot builds, but keep installation instructions
godot/builds/*
!godot/builds/README.md


# =========================
# IDE / Editor
# =========================

.vscode/
.idea/

# Vim swap files
*.swp
*.swo


# =========================
# Operating system files
# =========================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store


# =========================
# Temporary files
# =========================

*.tmp
*.temp
~$*